# Copy to .env next to docker-compose.yml on gomez and fill in. Never commit .env.

# Address used in email links. LAN address, or your Tailscale name/IP.
BASE_URL=http://your-server:5062

TZ=Europe/London

# Email through your SMTP relay (leave SMTP_HOST empty to turn email off)
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
EMAIL_FROM=parkrun@gomez.local
EMAIL_TO=

# When to check (Europe/London). Results usually appear 1-2 hours after 9am.
POLL_DAYS=saturday,sunday
POLL_TIMES=11:00,12:30,14:00,17:00,21:00
CATCHUP=monday 08:30

# http (default), browser (needs the :browser image) or manual (import pages only)
FETCHER=http
# Random pause between requests to parkrun, in seconds
REQUEST_DELAY=3-6
# Minimum seconds between "Check for results" button presses
REFRESH_COOLDOWN=300
# Email a warning after this many failed checks in a row
FAILURE_ALERT_THRESHOLD=3

# Header logo size tweak, if your logo (config/logo.png) looks too big or small: e.g. 1.2 or 0.9
LOGO_SCALE=1
